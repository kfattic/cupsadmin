{
  "comment": "Quick Action mappings per driver. First matching profile that defines an action AND whose keyword=value pairs this queue supports wins; 'generic' (empty match) must stay last. An action is either one list of pairs (all applied together) or a list of alternative lists. {value} is replaced with the user's input. 'inputs' can relabel an action's typed value (digitsOnly defaults to true) and add an optional second value ({value2}) with its own pairs. 'unavailable' maps an action id to the reason it can't be done with this driver (no later profile is tried). Find keywords with: cupsadmin ppdreport <queue | file.ppd>",
  "profiles": [
    {
      "id": "ricoh-m-c251fw",
      "name": "Ricoh M C251FW",
      "match": { "manufacturer": "^RICOH$", "nickname": "^RICOH M C251FW" },
      "actions": {
        "color": ["HQColorMode=COLOR"],
        "bw": ["HQColorMode=BW"],
        "duplex": ["Duplex=DuplexNoTumble"],
        "simplex": ["Duplex=None"],
        "letter": ["PageSize=Letter"]
      }
    },
    {
      "id": "ricoh",
      "name": "Ricoh",
      "match": { "manufacturer": "^RICOH$" },
      "actions": {
        "color": ["ColorModel=CMYK"],
        "bw": ["ColorModel=Gray"],
        "usercode": ["RIEnableUserCode=True", "RIUserCode=Custom.{value}"],
        "usercode-clear": ["RIEnableUserCode=False", "RIUserCode=None"],
        "duplex": ["Duplex=DuplexNoTumble"],
        "simplex": ["Duplex=None"],
        "letter": ["PageSize=Letter", "RIPaperPolicy=NearestSizeAdjust"]
      }
    },
    {
      "id": "canon",
      "name": "Canon UFR II / LIPSLX / CARPS2",
      "match": { "manufacturer": "^Canon$" },
      "actions": {
        "color": ["CNColorMode=color"],
        "bw": ["CNColorMode=mono"],
        "duplex": ["CNDuplex=DuplexFront"],
        "simplex": ["CNDuplex=None"],
        "letter": ["PageSize=Letter"]
      },
      "unavailable": {
        "usercode": "Canon department IDs are set by the Canon driver, not the PPD"
      }
    },
    {
      "id": "hp",
      "name": "HP",
      "match": { "manufacturer": "^HP$" },
      "actions": {
        "color": [["HPColorAsGray=False"], ["HPColorMode=colorsmart"]],
        "bw": [["HPColorAsGray=True"], ["HPColorMode=grayscale"]]
      },
      "unavailable": {
        "usercode": "HP drivers have no accounting code option"
      }
    },
    {
      "id": "xerox",
      "name": "Xerox",
      "match": { "manufacturer": "^Xerox$" },
      "actions": {
        "color": [["XROutputColor=PrintAsColor"], ["XRColorCorrection=Auto"]],
        "bw": [["XROutputColor=PrintAsGrayscale"], ["XRColorCorrection=Gray"]],
        "usercode": ["XRAccountingSystem=XSA", "AcctUserID=Custom.{value}"],
        "usercode-clear": ["XRAccountingSystem=None", "AcctUserID=None", "AcctAccountID=None"]
      },
      "inputs": {
        "usercode": {
          "label": "User ID",
          "digitsOnly": false,
          "second": { "label": "Account ID (optional)", "pairs": ["AcctAccountID=Custom.{value2}"] }
        }
      }
    },
    {
      "id": "konica-minolta",
      "name": "Konica Minolta",
      "match": { "manufacturer": "^KONICA MINOLTA$" },
      "actions": {
        "duplex": ["KMDuplex=Double"],
        "simplex": ["KMDuplex=Single"],
        "letter": ["PageSize=8.5x11"]
      },
      "unavailable": {
        "usercode": "Konica Minolta Account Track codes are set by the driver, not the PPD"
      }
    },
    {
      "id": "generic",
      "name": "Generic (standard PPD keywords, IPP Everywhere)",
      "match": {},
      "actions": {
        "color": [["ColorModel=CMYK"], ["ColorModel=RGB"], ["ColorModel=Color"], ["print-color-mode-default=color"]],
        "bw": [["ColorModel=Gray"], ["ColorModel=Grayscale"], ["print-color-mode-default=monochrome"]],
        "duplex": [["Duplex=DuplexNoTumble"], ["sides-default=two-sided-long-edge"]],
        "simplex": [["Duplex=None"], ["sides-default=one-sided"]],
        "letter": [["PageSize=Letter"], ["media-default=na_letter_8.5x11in"]]
      }
    }
  ]
}
